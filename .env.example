# TMDB credentials. Read on the server only (route handlers and server components),
# never sent to the browser. Do not prefix this with NEXT_PUBLIC_.
#
# Use a TMDB API key (v3, sent as the api_key query parameter) or a v4 API Read
# Access Token (starts with "eyJ", sent as an "Authorization: Bearer" header).
# Get one at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Optional: point the app at another TMDB compatible API, for example the mock
# server used by the Playwright suite. Defaults to https://api.themoviedb.org/3
# TMDB_API_BASE_URL=

# Optional: the public origin, for absolute canonical and hreflang URLs (https://watchlist.example). Defaults to the Vercel production URL, then http://localhost:3000.
# SITE_URL=
