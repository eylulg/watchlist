{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/**/{page,layout,not-found,global-not-found,error,loading}.tsx",
    "src/app/**/route.{ts,tsx}",
    "scripts/*.mjs",
    "src/test-utils/server-only-stub.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "e2e/**/*.ts", "scripts/**/*.mjs"],
  "ignore": ["src/components/base/**", "src/components/shared-assets/**", "src/utils/is-react-component.ts"],
  "ignoreDependencies": ["tailwindcss", "tailwindcss-animate", "tailwindcss-react-aria-components"]
}
